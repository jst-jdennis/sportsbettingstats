{
  "name": "wagering-policy-data-center",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Open, nonpartisan state-by-state data on legalized sports betting and prediction markets",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "validate": "python3 scripts/validate.py",
