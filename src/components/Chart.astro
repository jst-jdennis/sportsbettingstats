---
// Wraps a build-time SVG chart with its caption and a data table. The table
// is the accessible twin of the chart and is always present, so no value is
// reachable only by color or by hover. Pass the chart's DataTable and the
// table, its CSV link and the chart all come from the same rows.
import type { DataTable as TableDef } from '../lib/tables';
import { csvHref } from '../lib/tables';
import DataTable from './DataTable.astro';
interface Props { svg: string; caption?: string; legend?: { cls: string; name: string }[]; table?: TableDef; head?: string[]; rows?: (string | number | null | undefined)[][]; csv?: string; tableLabel?: string }
const { svg, caption, legend, table, head, rows, csv, tableLabel = 'Chart data' } = Astro.props;
const href = table ? csvHref(table) : csv;
---
<figure class="chart">
  {legend && legend.length > 1 && <ul class="legend" aria-label="Legend">{legend.map((l) => <li class={l.cls}>{l.name}</li>)}</ul>}
  <Fragment set:html={svg} />
  {caption && <figcaption><slot name="caption">{caption}</slot></figcaption>}
  {(table || (head && rows)) && (
    <details>
      <summary>{tableLabel}{href && <> (<a href={href} download>CSV</a>)</>}</summary>
      {table ? <DataTable t={table} rowHeader={false} /> : (
        <div class="table-wrap"><table>
          <thead><tr>{head!.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{rows!.map((r) => <tr>{r.map((c) => <td>{c ?? ''}</td>)}</tr>)}</tbody>
        </table></div>
      )}
    </details>
  )}
</figure>
