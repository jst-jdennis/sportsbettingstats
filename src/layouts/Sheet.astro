---
// Print layout for the per-state fact sheets. Self-contained styles, Letter
// page size, no site chrome: the PDF at /states/<abbr>/factsheet.pdf is this
// page printed by Chromium at build time (scripts/factsheets.mjs), so what a
// reader prints from the browser and what they download are the same thing.
import { SITE } from '../site.config';
import { commitHash, BUILD_DATE } from '../lib/data';
interface Props { title: string; description: string; canonicalPath: string; pagePath: string }
const { title, description, canonicalPath, pagePath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL((base + canonicalPath).replace(/\/+/g, '/'), Astro.site).toString();
const pageUrl = new URL((base + pagePath).replace(/\/+/g, '/'), Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {SITE.name}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex" />
  <link rel="alternate" type="application/pdf" href={`${base}${pagePath}factsheet.pdf`} />
  <style is:global>
    @page { size: Letter; margin: 0.6in 0.6in 0.7in; }
    :root { --fg: #1a1a1a; --muted: #555; --rule: #cfcfcf; --panel: #f3f4f6; --accent: #0b5394; }
    * { box-sizing: border-box; }
    html { font-family: Georgia, "Times New Roman", serif; font-size: 10pt; line-height: 1.33; color: var(--fg); background: #fff; }
    body { margin: 0 auto; max-width: 7.3in; padding: 0.4in 0.3in; }
    @media print { body { max-width: none; padding: 0; } .screen-only { display: none; } a { color: inherit; text-decoration: none; } }
    a { color: var(--accent); }
    h1 { font-size: 20pt; margin: 0; line-height: 1.1; }
    .kicker { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; text-transform: uppercase; letter-spacing: .08em; font-size: 8pt; color: var(--muted); margin: 0 0 .15rem; }
    .masthead { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; border-bottom: 2px solid var(--fg); padding-bottom: .35rem; margin-bottom: .6rem; }
    .masthead .site { text-align: right; font-size: 8.5pt; color: var(--muted); font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
    .masthead .site strong { display: block; color: var(--fg); font-size: 10pt; }
    .lede { font-size: 11pt; margin: .2rem 0 .6rem; }
    h2 { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-size: 10pt; text-transform: uppercase; letter-spacing: .06em; margin: .9rem 0 .25rem; padding-bottom: .1rem; border-bottom: 1px solid var(--rule); break-after: avoid; }
    h3 { font-size: 10.5pt; margin: .5rem 0 .15rem; break-after: avoid; }
    p { margin: .2rem 0 .4rem; }
    .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; margin: .5rem 0 .3rem; padding: 0; list-style: none; }
    .tiles li { background: var(--panel); border-radius: 3px; padding: .35rem .5rem; break-inside: avoid; }
    .tiles .label { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-size: 7.5pt; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
    .tiles .value { font-size: 12pt; font-weight: 700; line-height: 1.2; }
    .tiles .value.small { font-size: 10pt; }
    table { border-collapse: collapse; width: 100%; font-size: 9pt; margin: .2rem 0 .5rem; break-inside: auto; }
    th, td { text-align: left; vertical-align: top; padding: .18rem .35rem; border-bottom: 1px solid var(--rule); }
    th { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-weight: 600; font-size: 8pt; background: var(--panel); }
    tr { break-inside: avoid; }
    .num { text-align: right; font-variant-numeric: tabular-nums; }
    .cols { columns: 2; column-gap: 1.2rem; column-fill: balance; }
    .cols h2:first-child, .cols h3:first-child { margin-top: 0; }
    dl.kv { margin: .2rem 0 .4rem; }
    dl.kv dt { font-weight: 700; display: inline; }
    dl.kv dt::after { content: ": "; }
    dl.kv dd { display: inline; margin: 0; }
    dl.kv div { margin-bottom: .25rem; }
    .meta { color: var(--muted); font-size: 8.5pt; }
    sup.fn { font-size: 7pt; line-height: 0; color: var(--accent); font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
    ol.sources { font-size: 7.5pt; padding-left: 1.3rem; margin: .2rem 0; columns: 2; column-gap: 1.2rem; }
    ol.sources li { break-inside: avoid; margin-bottom: .15rem; }
    ol.sources .url { word-break: break-all; color: var(--muted); }
    .pending { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-size: 7pt; text-transform: uppercase; letter-spacing: .04em; color: #8a6d00; }
    .verified { font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-size: 7pt; text-transform: uppercase; letter-spacing: .04em; color: #1b7f3b; }
    .notice { border-left: 3px solid #8a6d00; background: var(--panel); padding: .3rem .5rem; margin: .4rem 0; font-size: 9pt; }
    .colophon { border-top: 2px solid var(--fg); margin-top: .8rem; padding-top: .3rem; font-size: 7.5pt; color: var(--muted); break-inside: avoid; }
    .colophon code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 8pt; }
    .screen-only { background: var(--panel); border: 1px solid var(--rule); border-radius: 3px; padding: .4rem .6rem; margin: 0 0 .8rem; font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; font-size: 9pt; }
    ul { margin: .2rem 0 .4rem; padding-left: 1.2rem; }
    li { margin-bottom: .1rem; }
  </style>
</head>
<body>
  <p class="screen-only">Printable fact sheet. The <a href={`${base}${pagePath}factsheet.pdf`}>PDF</a> is this page as rendered at build time. Full profile with every record and chart: <a href={pageUrl}>{pageUrl}</a>.</p>
  <slot />
  <div class="colophon">
    <p>{SITE.name}, {pageUrl}. Data as of the dates in the sources list; built {BUILD_DATE} from commit <code>{commitHash()}</code>, which pins every figure to the version of the data files it came from ({SITE.repoUrl}/tree/{commitHash()}). Data licensed {SITE.dataLicense.name}. "Pending review" marks a figure entered with its citation and not yet checked against that source by a second contributor; it is not a verified figure. The site presents evidence with its limitations and takes no position on legislation.</p>
    <p>Cite as: {SITE.name}. "{title}." {pageUrl} (built {BUILD_DATE}, commit {commitHash()}).</p>
  </div>
</body>
</html>
