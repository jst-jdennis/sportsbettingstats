---
import Base from '../../layouts/Base.astro';
import Chart from '../../components/Chart.astro';
import DataTable from '../../components/DataTable.astro';
import { bills, profiles, label, fmtDate, asOf } from '../../lib/data';
import { legislationIndexPage } from '../../lib/pageTables';
import { byId } from '../../lib/tables';
import { timeline } from '../../lib/charts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bs = bills();
const pg = legislationIndexPage();
const T = byId(pg);
const names = new Map(profiles().map((p) => [p.fips, p.name]));
const svg = timeline({
  id: 'bills', title: 'Bill actions and votes over time', desc: 'Timeline. One row per bill; dots mark recorded legislative actions and floor votes.',
  rows: bs.map((b) => ({
    label: `${names.get(b.fips)} ${b.bill_number}`, href: `${base}/legislation/${b.slug}/`,
    events: [
      ...(b.actions ?? []).map((a: any) => ({ date: a.date, cls: 's1', title: `${fmtDate(a.date)}, ${label(a.chamber)}: ${a.action_text}` })),
      ...(b.votes ?? []).map((v: any) => ({ date: v.date, cls: v.result === 'passed' ? 's3' : 's2', title: `${fmtDate(v.date)}, ${label(v.chamber)} vote: ${v.motion}. ${v.yeas} to ${v.nays}, ${v.result}.`, label: `${v.result} ${v.yeas} to ${v.nays}` })),
    ],
  })),
  rowHeight: 40, labelWidth: 170,
});
---
<Base title="Legislation tracker" asOf={asOf(bs)} pg={pg}>
  <h1>Legislation tracker</h1>
  <p class="lede">Bills that would authorize, restrict or tax sports wagering or prediction markets, with status, votes, sponsors and links to official text.</p>
  <div class="panel notice" role="note"><strong>Seeded by hand from primary documents.</strong> {bs.length} entr{bs.length === 1 ? 'y is' : 'ies are'} present, each built from the legislature's own bill page, journal or enrolled text. Automated intake from bill-tracking services is not yet built; entries are added as they are read and archived.</div>

  <h2 id="timeline">Actions and votes</h2>
  <Chart svg={svg} legend={[{ cls: 's1', name: 'Recorded action' }, { cls: 's3', name: 'Vote passed' }, { cls: 's2', name: 'Vote failed' }]} table={T.get('actions')} caption="Only actions entered with a source appear. A bill carried over between sessions shows a gap. Select a bill to open its page with the roll call." />

  <h2 id="all">All bills</h2>
  <DataTable t={T.get('bills')} />
</Base>
