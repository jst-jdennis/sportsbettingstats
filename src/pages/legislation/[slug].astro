---
import Base from '../../layouts/Base.astro';
import SourceRef from '../../components/SourceRef.astro';
import ReviewNotice from '../../components/ReviewNotice.astro';
import Chart from '../../components/Chart.astro';
import DataTable from '../../components/DataTable.astro';
import { barChartH, timeline } from '../../lib/charts';
import { bills, profiles, label, fmtDate, asOf } from '../../lib/data';
import { billPage } from '../../lib/pageTables';
import { byId } from '../../lib/tables';
export function getStaticPaths() { return bills().map((b) => ({ params: { slug: b.slug }, props: { b } })); }
const { b } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const st = profiles().find((p) => p.fips === b.fips)!;
const pageAsOf = asOf([b]);
const path = `/legislation/${b.slug}/`;
const pg = billPage(b);
const T = byId(pg);
const votes = (b.votes ?? []).filter((v: any) => v.yeas != null && v.nays != null);
const voteSvg = votes.length ? barChartH({
  id: 'votes', title: `${b.bill_number}: recorded floor votes`, desc: 'Horizontal stacked bar per recorded vote, yeas then nays, with a marker at the simple majority of votes cast.',
  rows: votes.map((v: any) => ({ label: `${label(v.chamber)}, ${fmtDate(v.date)}`, sub: v.result, segments: [{ value: v.yeas, cls: 's3', name: 'Yeas' }, { value: v.nays, cls: 's2', name: 'Nays' }] })),
  fmt: (v) => String(v), labelWidth: 190, rowHeight: 40, valueLabel: false,
  markers: votes.length === 1 ? [{ value: Math.floor((votes[0].yeas + votes[0].nays) / 2) + 1, label: 'majority of votes cast' }] : [],
}) : '';
const actionSvg = (b.actions ?? []).length ? timeline({
  id: 'actions', title: `${b.bill_number}: actions and votes`, desc: 'Timeline of the recorded legislative actions and votes on this bill, one row per chamber.',
  rows: ['house', 'senate', 'governor'].filter((c) => (b.actions ?? []).some((a: any) => a.chamber === c) || votes.some((v: any) => v.chamber === c)).map((c) => ({ label: label(c), events: [
    ...(b.actions ?? []).filter((a: any) => a.chamber === c).map((a: any) => ({ date: a.date, cls: 's1', title: `${fmtDate(a.date)}: ${a.action_text}`, label: a.action_text.length > 24 ? a.action_text.slice(0, 22) + '...' : a.action_text })),
    ...votes.filter((v: any) => v.chamber === c).map((v: any) => ({ date: v.date, cls: v.result === 'passed' ? 's3' : 's2', title: `${fmtDate(v.date)} vote: ${v.motion}, ${v.yeas} to ${v.nays}, ${v.result}`, label: `vote ${v.result}` })),
  ] })), rowHeight: 40, labelWidth: 120,
}) : '';
---
<Base title={`${st.name} ${b.bill_number} (${b.session})`} description={b.summary.slice(0, 200)} asOf={pageAsOf} canonicalPath={path} pg={pg}>
  <p class="meta"><a href={base + '/legislation/'}>Legislation</a> / <a href={`${base}/states/${st.abbr.toLowerCase()}/`}>{st.name}</a> / {b.bill_number}</p>
  <h1>{st.name} {b.bill_number}</h1>
  <p class="lede">{b.title}. <strong>{label(b.status)}</strong>{b.status_date && <>, {fmtDate(b.status_date)}</>}.</p>
  <ReviewNotice objs={[b]} />
  <dl class="kv">
    <dt>Session</dt><dd>{b.session}</dd>
    <dt>Market segment</dt><dd>{b.market_segment.map(label).join(', ')}</dd>
    <dt>Official text</dt><dd>{b.text_url ? <a href={b.text_url}>Bill text and history</a> : 'not entered'}</dd>
    {b.fiscal_note_url && <><dt>Fiscal note</dt><dd><a href={b.fiscal_note_url}>Document</a></dd></>}
  </dl>
  <h2>Summary</h2>
  <p>{b.summary}</p>
  {b.would && <><h3>What the bill would do</h3><ul>{b.would.map((w) => <li>{w}</li>)}</ul></>}
  {b.sponsors && <><h2>Sponsors</h2><ul>{b.sponsors.map((s: any) => <li>{s.name} ({label(s.chamber)}{s.party ? `, ${s.party}` : ''}), {label(s.role)}</li>)}</ul></>}
  <h2>Votes</h2>
  {votes.length > 0 && <Chart svg={voteSvg} legend={[{ cls: 's3', name: 'Yeas' }, { cls: 's2', name: 'Nays' }]} caption="Yeas and nays as recorded. The marker is a simple majority of votes cast, not the chamber's full membership; an override or a constitutional majority would need more." />}
  {T.votes ? <DataTable t={T.votes} /> : <p class="meta">No votes entered.</p>}
  <h2>Actions</h2>
  {(b.actions ?? []).length > 0 && <Chart svg={actionSvg} legend={[{ cls: 's1', name: 'Action' }, { cls: 's3', name: 'Vote passed' }, { cls: 's2', name: 'Vote failed' }]} caption="Recorded actions by chamber. Only actions entered with a source appear; the full list is below." />}
  {T.actions ? <DataTable t={T.actions} /> : <p class="meta">No actions entered.</p>}
  {b.notes && <><h2>Notes</h2><p>{b.notes}</p></>}
  <h2>Entry provenance</h2>
  <p><SourceRef p={b.provenance} /></p>
</Base>
