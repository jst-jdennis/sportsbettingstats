---
import Base from '../../layouts/Base.astro';
import Chart from '../../components/Chart.astro';
import SourceRef from '../../components/SourceRef.astro';
import Limitations from '../../components/Limitations.astro';
import fs from 'node:fs';
import { effectFigures, adoptionByYear, OUTCOME_LABEL, label, asOf, papers } from '../../lib/data';
import { dotPlot, lineChart, wrap, compact } from '../../lib/charts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const schemas = ['handle_revenue', 'bankruptcy', 'helpline'].map((n) => ({ name: n, s: JSON.parse(fs.readFileSync(`schemas/${n}.tableschema.json`, 'utf8')) }));

// Research estimates, percent change only, so that one axis is honest. Other units are listed in the table.
const figs = effectFigures();
const UNIT_FMT: Record<string, (v: number) => string> = {
  percent_change: (v) => `${v > 0 ? '+' : ''}${v}%`, percentage_points: (v) => `${v > 0 ? '+' : ''}${v} pts`, per_100k: (v) => `${v > 0 ? '+' : ''}${v} per 100k`, usd: (v) => `${v < 0 ? '-' : ''}$${compact(Math.abs(v))}`, index_points: (v) => `${v > 0 ? '+' : ''}${v}`,
};
const UNIT_LABEL: Record<string, string> = { percent_change: 'percent change', percentage_points: 'percentage points', per_100k: 'per 100,000 residents', usd: 'US dollars', index_points: 'index points' };
const pctFigs = [...figs];
const domainOrder = Object.keys(OUTCOME_LABEL);
pctFigs.sort((a, b) => domainOrder.indexOf(a.fig.outcome_domain) - domainOrder.indexOf(b.fig.outcome_domain) || a.paper.year_first_circulated - b.paper.year_first_circulated);
const unitCls: Record<string, string> = { population_average: 's1', household_level: 's2', bettor_level: 's3', mixed: 's0' };
const short = (p: any) => `${p.authors[0].split(' ').pop()}${p.authors.length > 1 ? ' et al.' : ''} (${p.year_first_circulated})`;
// One small multiple per outcome, each with its own axis. The quantities differ (a filing likelihood, a score level, a deposit flow), so they never share a scale.
const domains = [...new Set(pctFigs.map((f) => f.fig.outcome_domain))];
const facets = domains.map((d) => {
  const unit = pctFigs.find((f) => f.fig.outcome_domain === d)!.fig.value_unit;
  const rows = pctFigs.filter((f) => f.fig.outcome_domain === d && f.fig.value_unit === unit); // one unit per facet; others stay in the table
  const svg = dotPlot({
    id: `effects-${d}`, title: `${OUTCOME_LABEL[d] ?? label(d)}: estimated change after legalization, in ${UNIT_LABEL[unit]}`, desc: 'Dot plot with its own axis. Each dot is one published estimate; a hollow dot is a figure entered from a secondary summary and pending review. A bar shows a stated range. The same figures are in the table below the chart.',
    rows: rows.map(({ paper, fig }) => ({
      label: wrap(fig.description, 50, 2),
      sub: `${short(paper)}, ${label(paper.unit_of_effect)}${fig.provenance.status !== 'verified' ? ', ' + label(fig.provenance.status) : ''}`,
      value: fig.value_numeric, low: fig.range_low, high: fig.range_high, cls: unitCls[paper.unit_of_effect] ?? 's0', hollow: fig.provenance.status !== 'verified',
      title: `${paper.title}: ${fig.description}. ${fig.value_text}. ${fig.specification}. Measured at ${label(paper.unit_of_effect)}. Status: ${label(fig.provenance.status)}.`,
      href: `${base}/research/${paper.slug}/`,
    })),
    fmt: UNIT_FMT[unit], zeroLabel: 'no change', labelWidth: 330, width: 820, rowHeight: 50,
  });
  return `<p class="facet">${OUTCOME_LABEL[d] ?? label(d)}, ${UNIT_LABEL[unit]}</p>${svg}`;
});
const effectsSvg = facets.join('');
const legend = [{ cls: 's1', name: 'Population average' }, { cls: 's2', name: 'Household level' }, { cls: 's3', name: 'Bettor level' }, { cls: 'hollow', name: 'Hollow: pending review' }];
const effectsRows = figs.map(({ paper, fig }) => [OUTCOME_LABEL[fig.outcome_domain] ?? label(fig.outcome_domain), fig.description, fig.value_text, `${fig.value_numeric} ${label(fig.value_unit)}${fig.range_low != null ? ` (${fig.range_low} to ${fig.range_high})` : ''}`, short(paper), label(paper.unit_of_effect), label(fig.provenance.status)]);

// Context series: how many states had live wagering at the end of each year.
const adoption = adoptionByYear();
const adoptionSvg = lineChart({
  id: 'adoption', title: 'States with live sports wagering at year end', desc: 'Step chart of the number of states and DC with any live legal channel, and with live online wagering, at the end of each year since the first legal wager.',
  series: [
    { name: 'Any channel live', cls: 's1', points: adoption.map((a) => ({ x: a.year, y: a.any, title: `End of ${a.year}: ${a.any} states with any live channel` })) },
    { name: 'Online live', cls: 's2', points: adoption.map((a) => ({ x: a.year, y: a.online, title: `End of ${a.year}: ${a.online} states with live online wagering` })) },
  ],
  step: true, xTicks: adoption.map((a) => a.year), yFmt: String, height: 260,
});
const pageAsOf = asOf(papers());
---
<Base title="Outcomes" asOf={pageAsOf}>
  <h1>Outcomes</h1>
  <p class="lede">Descriptive state time series (monthly handle and revenue, bankruptcy filings per 100,000 residents, helpline contacts) as they are entered, each shown with the state's legalization dates marked and its limitations beside it. Series describe; they do not attribute. The causal estimates that do compare states with and without legal wagering live in the <a href={base + '/research/'}>research library</a> and are reproduced below under their authors' names.</p>

  <h2 id="estimates">From the research library: estimated effects of legalization</h2>
  <p>Each dot is one published estimate of how an outcome changed after a state legalized sports wagering, relative to states that had not. Each outcome has its own chart and its own axis, because the quantities differ: a bankruptcy filing is a rare event, a credit score is a level where a fraction of a percent is a large move, and net investment is a flow. The estimates are shown side by side, not combined. The color says what the number is an average over: everyone in a state, the households in a transaction dataset, or people who bet. Population averages are smaller than the effect on a household that bets, because most residents do not bet.</p>
  <Chart svg={effectsSvg} legend={legend} head={['Outcome', 'Figure', 'As stated', 'Charted value', 'Paper', 'Unit of effect', 'Review status']} rows={effectsRows} tableLabel="Estimates in these charts, with figures in other units">
    <Fragment slot="caption"><strong>Estimated change after legalization, one chart per outcome, each in the unit the paper uses.</strong> Positive values mean the outcome rose. A bar marks a range the paper states. A hollow dot is a figure marked pending review: it has been entered with its source and page or table, but not yet checked against that source by a second reviewer, so the methodology page's rule that pending records are not headline figures applies to it. Select a label to open the paper's entry, which lists the specification, the version it comes from and its limitations.</Fragment>
  </Chart>
  <h3>Reading these estimates</h3>
  <ul>
    <li>Bankruptcy and credit score figures (Hollenbeck, Larsen and Proserpio) are population averages from credit bureau records. The October 2024 draft stated both an average 10 percent increase in bankruptcy likelihood and a 25 to 30 percent event-study peak; the April 2025 draft reports about 10 percent and no longer states the peak; a 28 percent figure in 2024 press coverage appears in neither archived draft and is not charted. Each draft's figures are recorded in the entry with the version they come from.</li>
    <li>The intimate partner violence figure (Arnesen and Matsuzawa) is the additional rise in police reports after an unexpected NFL home loss once wagering is legal, in percentage points on top of the upset-loss effect, not a change in the overall rate.</li>
    <li>Two further entries are in the library but not charted until their figures are read from the paper: Baker and coauthors on household saving and investing (household-level transaction data), and Yeola and coauthors on searches for gambling addiction help, which rise with advertising of the helpline as well as with need.</li>
  </ul>
  <Limitations title="Limitations of the estimates above" items={[
    'Each figure is from a different paper, dataset and design; nothing is pooled. Differences between dots partly reflect differences in method.',
    'Working paper figures change between drafts. Each figure is tied to the version it appears in; superseded figures are kept in the entry and are not charted.',
    'Population averages are over everyone in a state, bettors and non-bettors alike. They understate the effect on a household that bets and are not comparable with household-level figures.',
    "Figures marked pending review have not been checked against their source by a second reviewer; each entry's provenance note says whether the figure was read from the paper or from a secondary summary.",
  ]} />
  <p class="meta">Sources for each figure: {figs.map(({ paper, fig }, i) => <>{i > 0 && '; '}<a href={`${base}/research/${paper.slug}/`}>{short(paper)}</a> <SourceRef p={fig.provenance} compact /></>)}. Papers in the library whose figures are not yet read from the paper (marked unverified) are listed on the <a href={base + '/research/'}>research page</a> and are not charted.</p>

  <h2 id="context">Context: how many states these estimates cover</h2>
  <p>Every estimate above compares states before and after legalization. This is the number of states with live wagering at the end of each year, from the profiles on this site, which is the treatment timeline those papers use.</p>
  <Chart svg={adoptionSvg} legend={[{ cls: 's1', name: 'Any channel live' }, { cls: 's2', name: 'Online live' }]} head={['Year end', 'Any channel live', 'Retail live', 'Online live']} rows={adoption.map((a) => [a.year, a.any, a.retail, a.online])} caption="Count of states and the District of Columbia whose profile records a first legal wager on or before December 31 of each year. Mobile wagering that works only on licensed premises counts as online, per the classification rule." />

  <h2 id="series">State time series</h2>
  <p>Monthly handle and revenue from state regulators, nonbusiness bankruptcy filings per 100,000 residents from the Administrative Office of the US Courts, and problem gambling helpline contacts from state councils. Each series will be shown with the state's legalization dates marked and its limitations beside it.</p>
  <div class="panel notice" role="note"><strong>Phase 2 section.</strong> No raw series are published yet. The schemas below are final and the two Phase 1 ingestion modules (US Courts bankruptcy tables, New Jersey monthly revenue) write to them. Charts will use the same build-time renderer as the ones above, with a data table under each.</div>
  <h3>What will and will not be claimed</h3>
  <ul>
    <li>Series are descriptive. A change after a legalization date is shown, not attributed. Causal estimates stay in the chart above, tied to their authors and their unit of effect.</li>
    <li>Revenue definitions differ by state and are stored verbatim on every row. Cross-state revenue comparisons are labeled with the definitions in use.</li>
    <li>Bankruptcy counts are quarterly, because that is what the courts publish. Monthly state counts exist behind a commercial subscription and are not used.</li>
    <li>Helpline volume rises when the number is advertised more. It measures help-seeking, not prevalence.</li>
  </ul>
  <h3>Known gaps as of this draft</h3>
  <ul>
    <li>No public state-level time series of 1-800-GAMBLER contacts was found from the National Council on Problem Gambling. State councils' own reports will be used where they exist, with each council's counting rule recorded.</li>
    <li>Prevalence studies use different instruments and are not comparable across studies; they will be presented as study records, not a series.</li>
  </ul>
  <h3>Schemas</h3>
  {schemas.map(({ name, s }) => (
    <section>
      <h4><code>data/outcomes/{name}.csv</code></h4>
      {s.description && <p class="meta">{s.description}</p>}
      <div class="table-wrap"><table>
        <thead><tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Constraints</th></tr></thead>
        <tbody>{s.fields.map((f: any) => <tr><td><code>{f.name}</code></td><td>{f.type}</td><td>{f.constraints ? Object.entries(f.constraints).map(([k, v]) => `${k}: ${Array.isArray(v) ? v.join(' | ') : v}`).join('; ') : ''}</td></tr>)}</tbody>
      </table></div>
    </section>))}
</Base>
