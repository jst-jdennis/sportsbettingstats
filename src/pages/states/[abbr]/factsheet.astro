---
// One printable fact sheet per state. Every figure carries a footnote number
// that resolves in the numbered source list at the end, so the printed page
// keeps the provenance the website shows inline. The rows come from the same
// registry as the state page's tables and CSVs.
import Sheet from '../../../layouts/Sheet.astro';
import type { Provenance } from '../../../lib/data';
import { profiles, pgFunding, predictionMarkets, bills, population, headlineStatus, HEADLINE_LABEL, scopeQualifiers, fmtDate, pct, label, asOf, collectProvenance, earliestLaunch, prevalenceStudies, prevalenceSearch, gradeFor, grades, source, rubrics } from '../../../lib/data';
import { statePage } from '../../../lib/pageTables';
import { hrFor, bkFor, hlFor, per100k, monthName } from '../../../lib/seriesCharts';
import { cellText, byId } from '../../../lib/tables';
export function getStaticPaths() { return profiles().map((p) => ({ params: { abbr: p.abbr.toLowerCase() }, props: { p } })); }
const { p } = Astro.props;
const pagePath = `/states/${p.abbr.toLowerCase()}/`;
const pg = pgFunding(p.abbr);
const pm = predictionMarkets(p.abbr);
const stateBills = bills().filter((b) => b.fips === p.fips);
const hs = headlineStatus(p);
const quals = scopeQualifiers(p);
const full = p.profile_completeness === 'full';
const cp = p.consumer_protections ?? {};
const T = byId(statePage(p));
const pageAsOf = asOf([p, pg, pm, ...stateBills].filter(Boolean));
const all = [p, pg, pm, ...stateBills].filter(Boolean).flatMap((o) => collectProvenance(o));
const pendingCount = all.filter((x) => x.status !== 'verified').length;
const card = gradeFor(p.abbr);
const rubric = rubrics().sort((a, b) => b.version.localeCompare(a.version))[0];
const pop = population().filter((r) => r.fips === p.fips && r.status !== 'superseded').sort((a, b) => Number(b.year) - Number(a.year))[0];

// Footnotes: one number per distinct source document, assigned in the order the sheet first cites it.
const notes: { p: Provenance; key: string }[] = [];
const keyOf = (x: Provenance) => `${x.source_url}|${x.page_or_table ?? ''}|${x.retrieved_at}|${x.status}`;
function cite(x: Provenance | null | undefined): number | null {
  if (!x) return null;
  const k = keyOf(x);
  let i = notes.findIndex((n) => n.key === k);
  if (i < 0) { notes.push({ p: x, key: k }); i = notes.length - 1; }
  return i + 1;
}
const seriesP = (r: { source_id: string; source_url: string; archive_url: string; retrieved_at: string; status: string; notes: string }): Provenance => ({ source_id: r.source_id, source_url: r.source_url, archive_url: r.archive_url || null, retrieved_at: r.retrieved_at, retrieval_method: 'ingest', entered_by: '', status: r.status as Provenance['status'], notes: r.notes || null });
const pub = (id: string) => { try { return source(id).publisher; } catch { return id; } };

// Latest outcome figures.
const hr = hrFor(p.fips).filter((r) => r.market_segment === 'regulated_sportsbook' && r.gross_revenue_usd !== '');
const lastMonth = hr.length ? hr[hr.length - 1].period_start : null;
const lastRev = lastMonth ? hr.filter((r) => r.period_start === lastMonth) : [];
const revStart = hr.length ? hr[0].period_start : null;
const bk12 = bkFor(p.fips).filter((r) => r.measure === 'twelve_months_ending' && r.chapter === 'all_nonbusiness');
const bkLast = bk12[bk12.length - 1];
const bkFirst = bk12[0];
const bkPk = bkLast ? per100k(Number(bkLast.filings), p.fips, Number(bkLast.period_end.slice(0, 4))) : null;
const bkFirstPk = bkFirst ? per100k(Number(bkFirst.filings), p.fips, Number(bkFirst.period_end.slice(0, 4))) : null;
const hl = hlFor(p.fips);
const hlLast = hl[hl.length - 1];
const studies = prevalenceStudies(p.fips).sort((a, b) => b.fieldwork_year - a.fieldwork_year);
const study = studies[0];
const search = study ? null : prevalenceSearch(p.fips);
const pickRate = (s: typeof study, m: string) => s?.rates.find((r) => r.measure === m) ?? null;
const headlineRates = ([['past_year_gambling', 'Gambled in past year'], ['past_30_day_gambling', 'Gambled in past 30 days'], ['past_year_sports_betting', 'Bet on sports'], ['at_risk_or_problem', 'At risk or problem gambling'], ['high_risk', 'High risk or probable disorder']] as const)
  .map(([m, name]) => ({ r: pickRate(study, m), name })).filter((x) => x.r) as { r: NonNullable<ReturnType<typeof pickRate>>; name: string }[];
const usd = (v: string | number) => `$${Number(v).toLocaleString()}`;
/** Source text joined into running copy: one trailing period, never two. */
const sentence = (t?: string | null) => (t ?? '').trim().replace(/\.*$/, '') + '.';
const pgLatest = pg?.records?.length ? [...pg.records].sort((a: any, b: any) => Number(b.fiscal_year) - Number(a.fiscal_year))[0] : null;
const latestAction = pm?.state_actions?.length ? [...pm.state_actions].sort((a: any, b: any) => (b.date ?? '').localeCompare(a.date ?? ''))[0] : null;
const minAge = p.legal_age?.length ? p.legal_age.reduce((a, b) => (a.age <= b.age ? a : b)) : null;
const title = `${p.name}: sports wagering and prediction markets fact sheet`;
const missing = [
  ['legal age', !!p.legal_age?.length], ['tax structure', !!p.tax?.length],
  ['consumer protections', !!p.consumer_protections && Object.values(p.consumer_protections).some((v) => v)],
  ['problem gambling funding', !!pg?.records?.length], ['prediction market status', !!pm],
].filter(([, present]) => !present).map(([name]) => name as string);
---
<Sheet title={title} description={p.summary ?? `Fact sheet: legal status, consumer protections and measured outcomes of sports wagering in ${p.name}, every figure footnoted to its source.`} canonicalPath={`${pagePath}factsheet/`} pagePath={pagePath}>
  <header class="masthead">
    <div>
      <p class="kicker">Fact sheet: sports wagering and prediction markets</p>
      <h1>{p.name}</h1>
    </div>
    <div class="site"><strong>Wagering Policy Data Center</strong>Open, nonpartisan, source-linked state data<br />Data as of {fmtDate(pageAsOf)}</div>
  </header>
  <p class="lede"><strong>{HEADLINE_LABEL[hs]}</strong>{quals.length ? ` (${quals.join('; ')})` : ''}.<sup class="fn">{p.legal_status.map((r) => cite(r.provenance)).filter((n, i, a) => a.indexOf(n) === i).join(',')}</sup> {p.summary ?? ''}</p>
  {pendingCount > 0 && <div class="notice"><strong>Draft data.</strong> {pendingCount} of {all.length} records behind this sheet are entered with a source and not yet checked by a second reviewer; the source list marks each one. {!full && <>This is a status-only profile: not yet entered for {p.name}: {missing.join(', ')}.</>}</div>}

  <ul class="tiles">
    <li><div class="label">Headline status</div><div class="value small">{HEADLINE_LABEL[hs]}</div></li>
    <li><div class="label">First legal wager</div><div class="value small">{hs === 'none' || hs === 'authorized_not_launched' ? 'None' : fmtDate(earliestLaunch(p))}</div></li>
    <li><div class="label">Minimum age</div><div class="value">{minAge ? <>{minAge.age}<sup class="fn">{cite(minAge.provenance)}</sup></> : <span class="small">not entered</span>}</div>{p.legal_age && p.legal_age.length > 1 && <div class="label">{p.legal_age.map((a) => `${a.age} ${label(a.scope)}`).join('; ')}</div>}</li>
    <li><div class="label">Report card, rubric {grades()?.rubric_version}</div><div class="value">{card?.grade ? <>{card.grade}{card.review === 'provisional' ? '*' : ''}</> : <span class="small">Incomplete</span>}</div><div class="label">{card ? `${card.points} of ${card.available} points${card.grade ? '' : `, ${card.criteria.filter((c) => c.status === 'scored').length} of ${card.criteria.length} criteria entered`}` : 'not computed'}</div></li>
  </ul>
  {card?.review === 'provisional' && <p class="meta">* Provisional: {card.inputs_pending_review} of the inputs behind the grade are pending review. The rubric scores adopted consumer protection policy, not outcomes; {rubric?.incomplete_rule}</p>}

  <h2>Legal status, regulated sportsbooks</h2>
  <table>
    <thead><tr><th>Channel</th><th>Status</th><th>Scope</th><th>Authorized</th><th>First wager</th><th>Authority</th><th>Model</th></tr></thead>
    <tbody>{p.legal_status.map((r) => <tr><td>{label(r.channel)}</td><td>{label(r.status)}<sup class="fn">{cite(r.provenance)}</sup></td><td>{r.scope === 'not_applicable' ? '' : label(r.scope)}</td><td>{r.status === 'not_authorized' ? '' : fmtDate(r.authorized_on)}</td><td>{r.status === 'not_authorized' ? '' : fmtDate(r.launched_on)}</td><td>{r.authority?.citation ?? ''}</td><td>{label(r.operator_model)}</td></tr>)}</tbody>
  </table>
  <p class="meta">Regulator{p.regulators.length > 1 ? 's' : ''}: {p.regulators.map((r, i) => <>{i > 0 && '; '}{r.name}{r.roles.length ? ` (${r.roles.map(label).join(', ')})` : ''}<sup class="fn">{cite(r.provenance)}</sup></>)}. Classification: online if any online channel is live statewide or on licensed premises; retail if any retail channel is live, including on tribal lands only.</p>

  <div class="cols">
    <div>
      <h2>Tax structure</h2>
      {p.tax?.length ? (
        <table>
          <thead><tr><th>Channel</th><th>Basis</th><th>Rate</th><th>Promotional deductions</th></tr></thead>
          <tbody>{T.tax!.rows.map((row, i) => <tr><td>{cellText(row[0])}</td><td>{cellText(row[1])}</td><td>{cellText(row[2])}<sup class="fn">{cite(T.tax!.prov![i])}</sup></td><td>{cellText(row[5]) || 'not stated'}</td></tr>)}</tbody>
        </table>
      ) : <p class="meta">Not yet entered.</p>}
      {p.tax?.length ? <p class="meta">Headline rates are not comparable across states without the basis and the promotional deduction rule.</p> : null}

      <h2>Problem gambling funding</h2>
      {pgLatest ? (<>
        <p><strong>FY{pgLatest.fiscal_year}: {pgLatest.amount_usd != null ? usd(pgLatest.amount_usd) : 'amount not entered'}</strong><sup class="fn">{cite(pgLatest.provenance)}</sup>{pgLatest.amount_usd != null && pop ? ` (about $${(pgLatest.amount_usd / Number(pop.population)).toFixed(2)} per resident, Census ${pop.year} estimate)` : ''}{pgLatest.amount_usd != null && pgLatest.amount_type ? `, ${label(pgLatest.amount_type)}` : ''}. Mechanism: {label(pgLatest.funding_mechanism)}{pgLatest.administering_agency ? `, administered by ${pgLatest.administering_agency}` : ''}.{pgLatest.authority_citation ? ` ${pgLatest.authority_citation}.` : ''}</p>
        {(pg?.records?.length ?? 0) > 1 && <p class="meta">{pg!.records.length} fiscal years on file; the full series is on the website.</p>}
      </>) : <p class="meta">Not yet entered.</p>}
    </div>
    <div>
      <h2>Consumer protections</h2>
      {full ? (<dl class="kv">
        <div><dt>Self-exclusion</dt><dd>{cp.self_exclusion ? <>{label(cp.self_exclusion.program_type)}{cp.self_exclusion.administered_by && <>, {cp.self_exclusion.administered_by}</>}{cp.self_exclusion.durations && <>; {cp.self_exclusion.durations.join(', ')}</>}<sup class="fn">{cite(cp.self_exclusion.provenance)}</sup></> : 'not entered'}</dd></div>
        <div><dt>Deposit limits</dt><dd>{cp.deposit_limits ? <>player-set limits {cp.deposit_limits.player_set_available ? 'available' : 'not available'}{cp.deposit_limits.mandatory_default != null && <>; default limit {cp.deposit_limits.mandatory_default ? 'mandatory' : 'not mandatory'}</>}{cp.deposit_limits.player_set_required_at_signup != null && <>; {cp.deposit_limits.player_set_required_at_signup ? 'set at signup' : 'not required at signup'}</>}<sup class="fn">{cite(cp.deposit_limits.provenance)}</sup></> : 'not entered'}</dd></div>
        <div><dt>Advertising</dt><dd>{cp.advertising?.length ? cp.advertising.map((a: any, i: number) => <>{i > 0 && '; '}{label(a.rule_type)}<sup class="fn">{cite(a.provenance)}</sup></>) : 'not entered'}</dd></div>
        <div><dt>Credit card deposits</dt><dd>{cp.credit_card_deposits ? <>{cp.credit_card_deposits.allowed ? 'permitted' : 'prohibited'}<sup class="fn">{cite(cp.credit_card_deposits.provenance)}</sup></> : 'not entered'}</dd></div>
        <div><dt>Helpline message</dt><dd>{cp.helpline_message ? <>{cp.helpline_message.required ? `required (${cp.helpline_message.required_number ?? 'number not entered'})` : 'not required'}<sup class="fn">{cite(cp.helpline_message.provenance)}</sup></> : 'not entered'}</dd></div>
      </dl>) : <p class="meta">Not yet entered.</p>}

      <h2>Prediction markets</h2>
      {pm ? (<>
        <p>As of {fmtDate(pm.as_of)}. {pm.operating_platforms.map((o: any, i: number) => <>{i > 0 && ' '}{o.platform}: {label(o.offers_in_state)} in {p.name}<sup class="fn">{cite(o.provenance)}</sup>.</>)}</p>
        <p>{latestAction ? <>{pm.state_actions.length} state action{pm.state_actions.length === 1 ? '' : 's'} recorded; latest {fmtDate(latestAction.date)}: {label(latestAction.action_type)} against {latestAction.target}<sup class="fn">{cite(latestAction.provenance)}</sup>.</> : 'No state enforcement action recorded.'} {pm.litigation.length ? <>{pm.litigation.length} case{pm.litigation.length === 1 ? '' : 's'} tracked: {pm.litigation.map((c: any, i: number) => <>{i > 0 && '; '}{c.case_name}, {label(c.status)}<sup class="fn">{cite(c.provenance)}</sup></>)}.</> : 'No litigation recorded.'}</p>
        <p class="meta">Event contracts on sports are offered by exchanges designated by the Commodity Futures Trading Commission; whether state gambling law reaches them is in active litigation. Platform volumes are not recorded.</p>
      </>) : <p class="meta">Not yet entered.</p>}
    </div>
  </div>

  <h2>Measured outcomes</h2>
  {!lastRev.length && !bkLast && !hlLast && !study && <p class="meta">No outcome series on file for {p.name} yet.</p>}
  <div class="cols">
    {lastRev.length > 0 && <div><h3>Sports wagering revenue, {monthName(lastMonth!)}</h3><p>{lastRev.map((r, i) => <>{i > 0 && '; '}{label(r.channel)} gross revenue {usd(r.gross_revenue_usd)}{r.state_tax_usd ? `, state tax ${usd(r.state_tax_usd)}` : ''}<sup class="fn">{cite(seriesP(r))}</sup></>)}. {sentence(hr[0].revenue_definition)} Series on file from {monthName(revStart!)}.</p></div>}
    {bkLast && <div><h3>Nonbusiness bankruptcy filings</h3><p>Twelve months ending {fmtDate(bkLast.period_end)}: {Number(bkLast.filings).toLocaleString()} filings{bkPk ? `, ${bkPk.value.toFixed(1)} per 100,000 residents (Census ${bkPk.pop!.year} estimate)` : ''}<sup class="fn">{cite(seriesP(bkLast))}</sup>.{bkFirst && bkFirst !== bkLast && bkFirstPk ? ` Twelve months ending ${fmtDate(bkFirst.period_end)}: ${bkFirstPk.value.toFixed(1)} per 100,000.` : ''} Filings respond to exemption law, income, debt, medical costs and court practice; a change after a legalization date is shown, not attributed.</p></div>}
    {hlLast && <div><h3>Problem gambling helpline</h3><p>{fmtDate(hlLast.period_start)} to {fmtDate(hlLast.period_end)}: {Number(hlLast.contacts).toLocaleString()} {label(hlLast.contact_type)}s, {hlLast.operator}<sup class="fn">{cite(seriesP(hlLast))}</sup>. Counting rule: {sentence(hlLast.counting_rule)} Helpline volume rises when the number is advertised more; it measures help-seeking, not prevalence.</p></div>}
    {study && <div><h3>Prevalence study, {study.fieldwork_year} fieldwork</h3><p>{study.title} ({study.conducted_by}; {study.instrument}{study.sample_size ? `; n = ${study.sample_size.toLocaleString()}` : ''}).<sup class="fn">{cite(study.provenance)}</sup> {headlineRates.map(({ r, name }, i) => <>{i > 0 && '; '}{name}: {r.value_pct}% of {r.denominator ?? 'respondents'}<sup class="fn">{cite(r.provenance)}</sup></>)}. Rates as published; not comparable with other studies unless the record says so.</p></div>}
    {search && <div><h3>Prevalence study</h3><p>{search.found ? `A search on ${fmtDate(search.searched_on)} found a study not yet entered${search.candidates?.length ? `: ${search.candidates.map((c) => `${c.title}${c.year ? ` (${c.year})` : ''}`).join('; ')}` : ''}.` : `No state-level prevalence study found in a search on ${fmtDate(search.searched_on)}.`} Searched: {search.scope}</p></div>}
  </div>

  <h2>Legislation tracked</h2>
  {stateBills.length ? <ul>{stateBills.map((b) => <li><strong>{b.bill_number}</strong> ({b.session}): {b.title}. {label(b.status)}{b.status_date ? `, ${fmtDate(b.status_date)}` : ''}.<sup class="fn">{cite(b.provenance)}</sup></li>)}</ul> : <p class="meta">No bills entered for {p.name} yet.</p>}

  {p.limitations?.length ? <><h2>Limitations</h2><ul>{p.limitations.map((t) => <li>{t}</li>)}</ul></> : null}

  <h2>Sources</h2>
  <ol class="sources">{notes.map(({ p: x }) => <li>{pub(x.source_id)}{x.page_or_table ? `, ${x.page_or_table}` : ''}. <span class="url">{x.source_url}</span> Retrieved {fmtDate(x.retrieved_at)}.{x.archive_url ? ' Archived.' : ''} <span class={x.status === 'verified' ? 'verified' : 'pending'}>{label(x.status)}</span></li>)}</ol>
</Sheet>
