{ "description": "Nonbusiness bankruptcy filings by state, summed from US Courts district tables. Limitations: filings respond to many factors; series has breaks at BAPCPA (2005) and the 2020 to 2021 trough; population-level counts cannot attribute cause.",
  "fields": [
  { "name": "fips", "type": "string", "constraints": { "required": true, "pattern": "^[0-9]{2}$" } },
  { "name": "period_start", "type": "date", "constraints": { "required": true } },
  { "name": "period_end", "type": "date", "constraints": { "required": true } },
  { "name": "measure", "type": "string", "constraints": { "required": true, "enum": ["quarter", "twelve_months_ending"] } },
  { "name": "chapter", "type": "string", "constraints": { "required": true, "enum": ["7", "11", "13", "all_nonbusiness"] } },
  { "name": "filings", "type": "integer", "constraints": { "required": true, "minimum": 0 } },
  { "name": "source_id", "type": "string", "constraints": { "required": true } },
  { "name": "source_url", "type": "string", "constraints": { "required": true } },
  { "name": "archive_url", "type": "string" },
  { "name": "retrieved_at", "type": "date", "constraints": { "required": true } },
  { "name": "status", "type": "string", "constraints": { "required": true, "enum": ["verified", "pending_review", "unverified", "disputed", "superseded"] } },
  { "name": "entered_by", "type": "string", "constraints": { "required": true } },
  { "name": "reviewed_by", "type": "string" },
  { "name": "notes", "type": "string" }
], "missingValues": [""] }
