{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wageringdata.org/schemas/sources.schema.json",
  "title": "Source registry",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "publisher", "publisher_type", "title", "url", "access_method", "update_cadence", "tier"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "publisher": { "type": "string" },
          "publisher_type": { "type": "string", "enum": ["state_regulator", "state_agency", "federal_agency", "court", "legislature", "nonprofit", "academic", "industry_association", "news", "platform"] },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "access_method": { "$ref": "provenance.schema.json#/$defs/access_method" },
          "update_cadence": { "type": "string", "enum": ["weekly", "monthly", "quarterly", "annual", "irregular", "one_time"] },
          "license": { "type": ["string", "null"] },
          "reliability_notes": { "type": ["string", "null"] },
          "tier": { "type": "string", "enum": ["primary", "secondary", "tertiary"] },
          "fips": { "type": ["string", "null"], "pattern": "^[0-9]{2}$" }
        }
      }
    }
  }
}
