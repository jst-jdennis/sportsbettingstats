{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wageringdata.org/schemas/paper.schema.json",
  "title": "Research library entry",
  "type": "object",
  "required": ["slug", "title", "authors", "year_first_circulated", "publication_status", "market_segment", "unit_of_effect", "plain_language_summary", "versions", "key_figures", "provenance"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "year_first_circulated": { "type": "integer" },
    "publication_status": { "type": "string", "enum": ["working_paper", "under_review", "forthcoming", "published"] },
    "venue": { "type": ["string", "null"] },
    "doi": { "type": ["string", "null"] },
    "canonical_url": { "type": ["string", "null"], "format": "uri" },
    "market_segment": { "$ref": "provenance.schema.json#/$defs/market_segment" },
    "unit_of_effect": { "type": "string", "enum": ["population_average", "bettor_level", "household_level", "mixed"] },
    "data_used": { "type": ["string", "null"] },
    "design": { "type": ["string", "null"] },
    "plain_language_summary": { "type": "string" },
    "methodology_notes": { "type": ["array", "null"], "items": { "type": "string" } },
    "limitations": { "type": ["array", "null"], "items": { "type": "string" } },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["version_label", "date", "url", "changes_summary"], "additionalProperties": false, "properties": { "version_label": { "type": "string" }, "date": { "type": "string", "format": "date" }, "date_precision": { "type": ["string", "null"], "enum": ["day", "month", "year", null] }, "url": { "type": "string", "format": "uri" }, "archive_url": { "type": ["string", "null"] }, "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "changes_summary": { "type": "string" } } }
    },
    "key_figures": {
      "type": "array",
      "items": { "type": "object", "required": ["figure_id", "description", "value_text", "specification", "version_label", "status", "provenance"], "additionalProperties": false, "properties": { "figure_id": { "type": "string" }, "description": { "type": "string" }, "value_text": { "type": "string", "description": "The figure as the paper states it, e.g. 'about 10 percent' or '0.3 percent'" }, "specification": { "type": "string" }, "version_label": { "type": "string" }, "status": { "type": "string", "enum": ["current", "superseded", "withdrawn"] }, "superseded_by": { "type": ["string", "null"] }, "page_or_table": { "type": ["string", "null"] }, "provenance": { "$ref": "provenance.schema.json" } } }
    },
    "citations_in_policy": { "type": ["array", "null"], "items": { "type": "object", "required": ["body", "date", "description"], "properties": { "body": { "type": "string" }, "date": { "type": "string", "format": "date" }, "description": { "type": "string" }, "url": { "type": ["string", "null"] } } } },
    "provenance": { "$ref": "provenance.schema.json" }
  }
}
