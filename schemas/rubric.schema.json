{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wageringdata.org/schemas/rubric.schema.json",
  "title": "Report card rubric",
  "type": "object",
  "required": [
    "version",
    "status",
    "effective_from",
    "criteria",
    "grade_bands",
    "no_market_rule",
    "incomplete_rule",
    "provisional_rule"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "preamble": {
      "type": [
        "string",
        "null"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "title",
          "data_path",
          "applies_to",
          "presence",
          "scoring",
          "max_points",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "data_path": {
            "type": "string"
          },
          "applies_to": {
            "type": "string",
            "enum": [
              "all_states",
              "states_with_regulated_market"
            ]
          },
          "scoring": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "when",
                "condition",
                "points"
              ],
              "additionalProperties": false,
              "properties": {
                "when": {
                  "$ref": "#/$defs/when"
                },
                "condition": {
                  "type": "string",
                  "description": "Human reading of the when clause"
                },
                "points": {
                  "type": "number"
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "max_points": {
            "type": "number"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_basis": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "presence": {
            "type": "string",
            "description": "Input name whose null value means the criterion has not been entered for the state"
          },
          "evidence_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the cited studies do and do not show about this criterion"
          }
        }
      }
    },
    "grade_bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "min_pct",
          "grade"
        ],
        "properties": {
          "min_pct": {
            "type": "number"
          },
          "grade": {
            "type": "string"
          }
        }
      }
    },
    "no_market_rule": {
      "type": "string"
    },
    "inputs_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "incomplete_rule": {
      "type": "string"
    },
    "provisional_rule": {
      "type": "string"
    }
  },
  "$defs": {
    "when": {
      "oneOf": [
        {
          "const": "otherwise"
        },
        {
          "type": "object",
          "required": [
            "var",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "ne",
                "in",
                "not_in",
                "gte",
                "lte",
                "gt",
                "lt",
                "is_null",
                "not_null"
              ]
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/when"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/when"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/when"
            }
          }
        }
      ]
    }
  }
}
